{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KJyang-0114/sift/blob/main/docs/schemas/finding-v2.schema.json",
  "title": "Sift Finding v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fingerprint",
    "source",
    "rule",
    "message",
    "severity",
    "category",
    "confidence",
    "location",
    "related_locations",
    "evidence",
    "remediation",
    "suppression"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "id": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": { "type": "string", "minLength": 1 },
    "rule": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "category": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "location": { "$ref": "#/$defs/location" },
    "related_locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "remediation": { "type": "string", "minLength": 1 },
    "help_uri": { "type": "string", "format": "uri" },
    "cwe": { "type": "string" },
    "owasp": { "type": "string" },
    "suppression": { "$ref": "#/$defs/suppression" }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!\\.\\.?/).+"
        },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "end_column": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["code", "dependency", "execution", "model", "other"] },
        "snippet": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string" }
      },
      "anyOf": [
        { "required": ["snippet"] },
        { "required": ["description"] }
      ]
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppressed"],
      "properties": {
        "suppressed": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
